-- Analysis Tab Left: Labels
local StatusLabels = {
	Turn = AnalysisLeft:AddLabel("Turn: -"),
	BestMove = AnalysisLeft:AddLabel("Best move: -"),
	Evaluation = AnalysisLeft:AddLabel("Evaluation: -"),
	Depth = AnalysisLeft:AddLabel("Depth: -"),
	SearchTime = AnalysisLeft:AddLabel("Search time: -"),
}

UpdateStatusUI = function()
	local payload = Bridge.payload
	local state = Bridge.state
	local result = Analysis.current

	-- Turn
	if not payload or not state then
		StatusLabels.Turn:SetText("Turn: no game")
	elseif payload.over then
		StatusLabels.Turn:SetText("Turn: game over")
	else
		local side = state.turn == 1 and "White" or "Black"
		local mine = payload.you == state.turn
		StatusLabels.Turn:SetText("Turn: " .. side .. (mine and " (you)" or ""))
	end

	-- Best Move
	if result and result.best then
		StatusLabels.BestMove:SetText("Best move: " .. tostring(result.best.san))
		StatusLabels.Evaluation:SetText("Evaluation: " .. formatEvaluation(result.best.score, result.turn))
	else
		StatusLabels.BestMove:SetText("Best move: -")
		StatusLabels.Evaluation:SetText("Evaluation: -")
	end

	-- Depth
	if Analysis.busy then
		StatusLabels.Depth:SetText("Depth: searching...")
	elseif result then
		StatusLabels.Depth:SetText("Depth: d" .. tostring(result.depth))
	else
		StatusLabels.Depth:SetText("Depth: -")
	end

	-- Time
	if result then
		StatusLabels.SearchTime:SetText(string.format("Search time: %d ms", math.floor(result.elapsed * 1000)))
	else
		StatusLabels.SearchTime:SetText("Search time: -")
	end
end

