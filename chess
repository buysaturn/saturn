local levelKeys = {}
for key in pairs(Bot.LEVELS) do
	table.insert(levelKeys, key)
end
table.sort(levelKeys, function(a, b)
	local left = Bot.LEVELS[a]
	local right = Bot.LEVELS[b]
	return (left and left.elo or 0) < (right and right.elo or 0)
end)

local defaultBotIndex = 1
for i, name in ipairs(levelKeys) do
	if name == Settings.botLevel then
		defaultBotIndex = i
		break
	end
end

PlayRight:AddDropdown("ChessBotLevel", {
	Values = levelKeys,
	Default = defaultBotIndex,
	Multi = false,
	Text = "Computer level"
})

