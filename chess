local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"

local Library, ThemeManager, SaveManager

local _cache = getgenv and getgenv().__ObsidianCache
if _cache and _cache.Library and _cache.ThemeManager and _cache.SaveManager then
	Library     = _cache.Library
	ThemeManager = _cache.ThemeManager
	SaveManager  = _cache.SaveManager
else
	-- parallel fetch: все три HttpGet идут одновременно
	local loaded = {}
	local urls = {
		Library     = repo .. "Library.lua",
		ThemeManager = repo .. "addons/ThemeManager.lua",
		SaveManager  = repo .. "addons/SaveManager.lua",
	}
	local pending = 0
	for key, url in pairs(urls) do
		pending += 1
		task.spawn(function()
			local ok, result = pcall(function()
				return loadstring(game:HttpGet(url))()
			end)
			loaded[key] = ok and result or error("[Saturn] failed to load " .. key)
			pending -= 1
		end)
	end
	while pending > 0 do task.wait() end
	Library      = loaded.Library
	ThemeManager = loaded.ThemeManager
	SaveManager  = loaded.SaveManager
	-- кешируем в getgenv чтобы реинжект не качал снова
	if getgenv then
		getgenv().__ObsidianCache = { Library = Library, ThemeManager = ThemeManager, SaveManager = SaveManager }
	end
end

