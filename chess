-- Analysis Tab Right: Candidate moves
local CandidateLabels = {
	AnalysisRight:AddLabel("#1: -"),
	AnalysisRight:AddLabel("#2: -"),
	AnalysisRight:AddLabel("#3: -"),
}

PushCandidateUI = function(result)
	if not result or not result.top then
		for _, l in ipairs(CandidateLabels) do
			l:SetText("-")
		end
		return
	end
	for i = 1, 3 do
		local cand = result.top[i]
		if cand then
			CandidateLabels[i]:SetText(string.format("#%d %s (%s)", i, tostring(cand.san), formatEvaluation(cand.score, result.turn)))
		else
			CandidateLabels[i]:SetText(string.format("#%d: -", i))
		end
	end
end

local statusLoopThread = task.spawn(function()
	local prevSig = nil
	while true do
		task.wait(0.4)
		if Bridge.signature ~= prevSig then
			prevSig = Bridge.signature
			if not Analysis.busy and Analysis.current == nil then
				PushCandidateUI(nil)
			end
		end
		UpdateStatusUI()
	end
end)

